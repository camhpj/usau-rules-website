{
	"name": "Claude Sandbox (Best Perspective)",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"TZ": "${localEnv:TZ:America/New_York}",
			"CLAUDE_CODE_VERSION": "latest"
		}
	},
	"runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
	"remoteUser": "dev",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
	"workspaceFolder": "/workspace",
	"mounts": [
		"source=bp-sandbox-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
		"source=bp-sandbox-claude-${devcontainerId},target=/home/dev/.claude,type=volume",
		// Per-container node_modules volume. Keeps the Linux tree installed inside
		// the container off the host bind mount, so the macOS node_modules in the
		// repo root isn't clobbered (and vice versa) — workerd, esbuild and rollup
		// all ship platform-specific binaries. Scoped by devcontainerId so each
		// worktree gets its own.
		"source=bp-sandbox-node-modules-${devcontainerId},target=/workspace/node_modules,type=volume",
		// Playwright's browser store. Chromium is ~150MB; the named volume keeps it
		// across container rebuilds so postCreateCommand doesn't re-download it.
		"source=bp-sandbox-playwright,target=/home/dev/.cache/ms-playwright,type=volume",
		"source=bp-sandbox-npmcache,target=/home/dev/.npm,type=volume",
		// Worktree-only: exposes the main repo's .git at its absolute host path so
		// the worktree's .git pointer resolves inside the container. Assumes the
		// workspace lives at <repo>/.claude/worktrees/<name>. Remove this line if
		// opening the main repo directly — the source won't exist and the mount
		// will fail. Optional mounts (microsoft/vscode-remote-release#5322) would
		// let one config handle both cases; until then this is the trade.
		"source=${localWorkspaceFolder}/../../../.git,target=${localWorkspaceFolder}/../../../.git,type=bind"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/dev/.claude"
	},
	"remoteEnv": {
		"CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
		"GH_TOKEN": "${localEnv:GH_TOKEN}"
	},
	"forwardPorts": [5173, 8787],
	"portsAttributes": {
		"5173": { "label": "vite dev" },
		"8787": { "label": "wrangler dev (e2e baseURL)" }
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"svelte.svelte-vscode",
				"bradlc.vscode-tailwindcss",
				"esbenp.prettier-vscode"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"files.associations": { "*.css": "tailwindcss" },
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}
	},
	// The .git bind mount above is owned by the host user, which git reads as
	// dubious ownership; this is a single-user sandbox, so trust the lot.
	"postCreateCommand": "gh auth setup-git && git config --global --add 'url.https://github.com/.insteadOf' 'git@github.com:' && git config --global --add 'url.https://github.com/.insteadOf' 'ssh://git@github.com/' && git config --global --add safe.directory '*' && { [ -f .dev.vars ] || cp .dev.vars.example .dev.vars; } && npm ci && npx playwright install chromium",
	"postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
	"waitFor": "postStartCommand"
}
